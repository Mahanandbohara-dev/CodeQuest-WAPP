@{
    ViewData["Title"] = "AI Coding Tutor";
}

<div class="dashboard-page" style="max-width: 1000px; margin: 0 auto;">
    <!-- Page Header -->
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
        <div>
            <span class="auth-tag">INTERACTIVE MENTORSHIP</span>
            <h1 style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;">
                <span>🤖</span> CodeQuest AI Tutor
            </h1>
            <p>Ask coding questions, request explanations, debug syntax, or explore programming concepts across Python, JavaScript, Java, C++, and SQL.</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <a href="/Dashboard" class="button secondary compact">Dashboard</a>
            <a href="/Home/Topics" class="button secondary compact">Quizzes</a>
        </div>
    </div>

    <!-- Main Chat Container -->
    <div class="card" style="display: flex; flex-direction: column; height: 680px; padding: 0; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1); background: #0f172a;">
        <!-- Chat Header Bar -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; background: rgba(30, 41, 59, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 10px; height: 10px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 8px #22c55e;"></div>
                <div>
                    <strong style="color: #f8fafc; font-size: 0.95rem;">Claude 3.5 Sonnet / CodeQuest Mentor</strong>
                    <span style="display: block; font-size: 0.75rem; color: #94a3b8;">Online • Ready for programming assistance</span>
                </div>
            </div>
            <button class="button secondary compact" onclick="clearChat()" style="font-size: 0.8rem; padding: 0.35rem 0.75rem;">
                🗑️ Clear Chat
            </button>
        </div>

        <!-- Chat Messages Stream -->
        <div id="chatMessages" style="flex: 1; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            <!-- Welcome Message from AI -->
            <div class="chat-message assistant">
                <div class="chat-avatar">🤖</div>
                <div class="chat-bubble">
                    <p style="margin: 0 0 0.5rem;">Hello <strong>@ViewBag.Username</strong>! 👋 I'm your CodeQuest AI Tutor.</p>
                    <p style="margin: 0 0 0.5rem;">I can help you break down tricky syntax, explain algorithms, explore OOP principles, or prepare for your next quiz. What programming topic would you like to explore today?</p>
                    <div style="margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.4rem;">
                        <button class="prompt-chip" onclick="askQuickPrompt('Explain recursion with an easy Python example')">Recursion in Python</button>
                        <button class="prompt-chip" onclick="askQuickPrompt('How does async/await work in JavaScript?')">Async/Await in JS</button>
                        <button class="prompt-chip" onclick="askQuickPrompt('Explain the 4 pillars of OOP')">4 Pillars of OOP</button>
                        <button class="prompt-chip" onclick="askQuickPrompt('Difference between stack and heap memory in C++')">Stack vs Heap in C++</button>
                        <button class="prompt-chip" onclick="askQuickPrompt('How do parameterized queries prevent SQL injection?')">SQL Injection Defense</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Typing Indicator (Hidden by default) -->
        <div id="typingIndicator" style="display: none; padding: 0.5rem 1.5rem; font-size: 0.85rem; color: #94a3b8; font-style: italic;">
            🤖 AI Tutor is typing a response...
        </div>

        <!-- Chat Input Footer -->
        <div style="padding: 1rem 1.5rem; background: rgba(30, 41, 59, 0.7); border-top: 1px solid rgba(255, 255, 255, 0.08);">
            <form id="chatForm" onsubmit="handleSend(event)" style="display: flex; gap: 0.75rem; align-items: center;">
                <input id="userQuery" type="text" placeholder="Type your programming question (e.g. How does a binary search work?)..."
                       autocomplete="off" style="flex: 1; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: #f8fafc;" />
                <button id="sendBtn" type="submit" class="button primary" style="padding: 0.75rem 1.5rem;">
                    Send 🚀
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .chat-message {
        display: flex;
        gap: 0.75rem;
        max-width: 85%;
        animation: fadeIn 0.2s ease-in-out;
    }
    .chat-message.user {
        align-self: flex-end;
        flex-direction: row-reverse;
    }
    .chat-message.assistant {
        align-self: flex-start;
    }
    .chat-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        flex-shrink: 0;
    }
    .chat-message.user .chat-avatar {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        color: white;
        font-weight: bold;
        font-size: 1rem;
    }
    .chat-bubble {
        padding: 0.9rem 1.15rem;
        border-radius: 12px;
        font-size: 0.92rem;
        line-height: 1.55;
        color: #e2e8f0;
    }
    .chat-message.assistant .chat-bubble {
        background: #1e293b;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-top-left-radius: 2px;
    }
    .chat-message.user .chat-bubble {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #ffffff;
        border-top-right-radius: 2px;
    }
    .prompt-chip {
        background: rgba(59, 130, 246, 0.12);
        color: #93c5fd;
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 20px;
        padding: 0.35rem 0.75rem;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
    }
    .prompt-chip:hover {
        background: rgba(59, 130, 246, 0.25);
        color: #ffffff;
        transform: translateY(-1px);
    }
    .chat-code-block {
        background: #090d16;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        padding: 0.75rem 1rem;
        margin: 0.6rem 0;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.86rem;
        color: #38bdf8;
        overflow-x: auto;
        white-space: pre-wrap;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@section Scripts {
<script>
    let chatHistory = [];

    function askQuickPrompt(text) {
        document.getElementById('userQuery').value = text;
        document.getElementById('chatForm').dispatchEvent(new Event('submit'));
    }

    async function handleSend(e) {
        e.preventDefault();
        const input = document.getElementById('userQuery');
        const text = input.value.trim();
        if (!text) return;

        input.value = '';

        // Append user bubble
        appendMessage('user', text, '@(ViewBag.Username?.ToString()?.Substring(0, 1)?.ToUpper() ?? "U")');

        chatHistory.push({ role: 'user', content: text });

        // Show typing indicator & disable input
        const indicator = document.getElementById('typingIndicator');
        const sendBtn = document.getElementById('sendBtn');
        indicator.style.display = 'block';
        sendBtn.disabled = true;

        scrollToBottom();

        try {
            const res = await fetch('/Ai/Chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text, history: chatHistory })
            });

            if (!res.ok) {
                appendMessage('assistant', 'Sorry, an error occurred while processing your request. Please try again.', '🤖');
            } else {
                const data = await res.json();
                const reply = data.reply || 'No response received.';
                appendMessage('assistant', reply, '🤖');
                chatHistory.push({ role: 'assistant', content: reply });
            }
        } catch (err) {
            appendMessage('assistant', 'Network connection error. Please verify your connection.', '🤖');
        } finally {
            indicator.style.display = 'none';
            sendBtn.disabled = false;
            scrollToBottom();
            input.focus();
        }
    }

    function appendMessage(role, text, avatarChar) {
        const stream = document.getElementById('chatMessages');
        const msgDiv = document.createElement('div');
        msgDiv.className = `chat-message ${role}`;

        const avatarDiv = document.createElement('div');
        avatarDiv.className = 'chat-avatar';
        avatarDiv.innerText = avatarChar;

        const bubbleDiv = document.createElement('div');
        bubbleDiv.className = 'chat-bubble';

        // Format message (handles markdown code blocks and newlines)
        bubbleDiv.innerHTML = formatMessageText(text);

        msgDiv.appendChild(avatarDiv);
        msgDiv.appendChild(bubbleDiv);
        stream.appendChild(msgDiv);
    }

    function formatMessageText(text) {
        // Escape HTML
        let escaped = text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");

        // Format ```code blocks```
        escaped = escaped.replace(/```([a-zA-Z]*)\n([\s\S]*?)```/g, (match, lang, code) => {
            return `<pre class="chat-code-block"><code>${code.trim()}</code></pre>`;
        });

        // Format `inline code`
        escaped = escaped.replace(/`([^`]+)`/g, '<code style="background: rgba(255,255,255,0.1); padding: 2px 5px; border-radius: 4px; color: #38bdf8;">$1</code>');

        // Format **bold**
        escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

        // Format newlines
        escaped = escaped.replace(/\n/g, '<br/>');

        return escaped;
    }

    function scrollToBottom() {
        const stream = document.getElementById('chatMessages');
        stream.scrollTop = stream.scrollHeight;
    }

    function clearChat() {
        if (!confirm('Clear your conversation history?')) return;
        chatHistory = [];
        const stream = document.getElementById('chatMessages');
        stream.innerHTML = `
            <div class="chat-message assistant">
                <div class="chat-avatar">🤖</div>
                <div class="chat-bubble">
                    <p style="margin: 0;">Chat cleared! How can I help you today?</p>
                </div>
            </div>
        `;
    }
</script>
}
