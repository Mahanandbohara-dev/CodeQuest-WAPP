@model LoginViewModel

<section class="auth-section">
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-tag">WELCOME BACK</span>
            <h1>Learner Login</h1>
            <p>Access your dashboard, continue your streaks, and take daily quizzes.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">
                <span>⚠</span> @ViewBag.Error
            </div>
        }

        <form method="post" asp-action="Login" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="form-group">
                <label asp-for="Identifier">Username or Email</label>
                <input asp-for="Identifier" placeholder="Enter your username or email" autocomplete="username" autofocus />
                <span asp-validation-for="Identifier" class="field-validation"></span>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label asp-for="Password">Password</label>
                </div>
                <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <div class="form-options">
                <label class="checkbox-label">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>Remember this session</span>
                </label>
            </div>

            <button class="button primary block" type="submit">Sign In →</button>
        </form>

        <div class="auth-hint">
            <small>Demo Accounts: <code>admin</code> (Password: <code>Admin@123</code>) or <code>prabit</code> (Password: <code>User@123</code>)</small>
        </div>

        <div class="auth-footer">
            <p>New to CodeQuest? <a href="/Account/Register">Create an account</a></p>
        </div>
    </div>
</section>
