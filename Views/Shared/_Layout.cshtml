<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CodeQuest • Master Coding by Doing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="nav">
        <a class="brand" href="/">
            <span class="brand-icon">CQ</span>
            <span class="brand-text">CodeQuest</span>
            <span class="brand-dot"></span>
        </a>
        <nav class="nav-links">
            <a href="/" class="nav-item">Home</a>
            <a href="/Home/Topics" class="nav-item">Topics</a>
            <a href="/Dashboard/Games" class="nav-item">Mini-Games 🎮</a>
            <a href="/Ai/Chat" class="nav-item">AI Tutor 🤖</a>
            <a href="/Community" class="nav-item">Leaderboard</a>
            <a href="/Home/About" class="nav-item">About</a>
        </nav>
        <div class="nav-actions">
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <a href="/Dashboard" class="button secondary compact">Dashboard</a>
                <a href="/Dashboard/EditProfile" class="button secondary compact" title="Edit your account profile">✏️ Profile</a>
                <a href="/Dashboard/Games" class="button secondary compact" title="Play relaxing mini-games">🎮 Games</a>
                @if (Context.Session.GetString("Role") == "Administrator")
                {
                    <a href="/Admin" class="button admin-badge compact">Admin</a>
                }
                <div class="user-chip">
                    <span class="user-avatar">@(Context.Session.GetString("Username")?.Substring(0, 1).ToUpper() ?? "U")</span>
                    <span class="user-name">@Context.Session.GetString("Username")</span>
                </div>
                <a href="/Account/Logout" class="logout-link" title="Logout">⏻</a>
            }
            else
            {
                <a href="/Account/Login" class="nav-item">Log in</a>
                <a href="/Account/Register" class="button primary compact">Get Started</a>
            }
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="toast toast-success" id="toastMsg">
            <span>✓</span> @TempData["Success"]
            <button type="button" onclick="this.parentElement.remove()">×</button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast toast-error" id="toastMsg">
            <span>⚠</span> @TempData["Error"]
            <button type="button" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-col">
                <div class="brand footer-brand">
                    <span class="brand-icon">CQ</span>
                    <span>CodeQuest</span>
                </div>
                <p>Interactive programming learning platform connecting database-driven quizzes, progress tracking, and AI tutoring.</p>
            </div>
            <div class="footer-col">
                <h4>Explore</h4>
                <a href="/Home/Topics">Programming Topics</a>
                <a href="/Ai/Chat">AI Coding Tutor 🤖</a>
                <a href="/Community">Community Leaderboard</a>
                <a href="/Home/About">Our Mission</a>
            </div>
            <div class="footer-col">
                <h4>Languages</h4>
                <div class="footer-tags">
                    <span>Python</span><span>JavaScript</span><span>Java</span>
                    <span>C++</span><span>HTML</span><span>CSS</span>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© @DateTime.Now.Year CodeQuest. Connected to SQL Server LocalDB. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
